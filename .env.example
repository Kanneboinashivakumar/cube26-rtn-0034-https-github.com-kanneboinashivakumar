# ====================
# Environment — secrets
# ====================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Gemini AI — model is set via env, never hardcoded
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Demo organisation / operator (safe to expose — demo values only)
NEXT_PUBLIC_ORG_ID=org_demo_alpha
NEXT_PUBLIC_CLIENT_ID=client_demo_001
NEXT_PUBLIC_OPERATOR_LABEL=demo_operator
